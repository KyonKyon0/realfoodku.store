RewriteEngine On

# Route khusus harus ditaruh di atas rule umum
RewriteRule ^produk/nugget-ayam-crispy/?$ nugget-ayam-crispy.php [L,QSA]
RewriteRule ^produk/([0-9]+)/?$ detail.php?id=$1 [L,QSA]

# Hilangkan ekstensi .php dari URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^/]+)/?$ $1.php [L]
